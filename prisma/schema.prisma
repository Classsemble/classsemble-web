// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  canvasId  String    @unique
  name      String
  role      String
  email     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  meetings  Meeting[] @relation("UserMeetings")
  messages  Message[]
  createdMeetings Meeting[] @relation("MeetingCreator")
  
  @@index([canvasId])
}

model Meeting {
  id         String   @id @default(uuid())
  courseId   String
  title      String
  description String?
  startTime  DateTime
  endTime    DateTime
  location   String?
  zoomLink   String?
  googleEventId String?
  createdBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  creator    User     @relation("MeetingCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  attendees  User[]   @relation("UserMeetings")
  
  @@index([courseId])
  @@index([createdBy])
  @@index([startTime])
}

model Message {
  id        String   @id @default(uuid())
  courseId  String
  userId    String
  content   String
  timestamp DateTime @default(now())
  edited    Boolean  @default(false)
  editedAt  DateTime?
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([courseId])
  @@index([userId])
  @@index([timestamp])
}

model Course {
  id          String   @id @default(uuid())
  canvasId    String   @unique
  name        String
  code        String?
  term        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([canvasId])
}

model LtiSession {
  id              String   @id @default(uuid())
  userId          String
  canvasId        String
  courseId        String
  role            String
  sessionToken    String   @unique
  ltiMessageType  String?
  deploymentId    String?
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  
  @@index([sessionToken])
  @@index([userId])
  @@index([canvasId])
}
