DATABASE_URL="postgresql://classsemble:password@localhost:5432/classsemble_db?schema=public"

# LTI 1.3 Configuration
LTI_KEYSET_URL="https://canvas.instructure.com/api/lti/security/jwks"
LTI_CLIENT_ID="your_canvas_client_id"
LTI_DEPLOYMENT_ID="your_deployment_id"
LTI_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYourPrivateKeyHere\n-----END RSA PRIVATE KEY-----"

# JWT Secret for session management
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Google Calendar Integration (Optional)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Zoom Integration (Optional)
ZOOM_API_KEY="your-zoom-api-key"
ZOOM_API_SECRET="your-zoom-api-secret"

# Socket.IO Port (Optional, defaults to 3001)
SOCKET_PORT="3001"

# API Base URL
API_BASE="/api"

# Node Environment
NODE_ENV="development"
